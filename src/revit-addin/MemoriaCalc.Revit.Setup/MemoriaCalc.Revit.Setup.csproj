<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>MemoriaCalc.Revit.Setup</AssemblyName>
    <RootNamespace>MemoriaCalc.Revit.Setup</RootNamespace>
    <Version>2.0.0</Version>
    <Product>MemoriaCalc para Autodesk Revit</Product>
    <Company>MemoriaCalc</Company>
    <Description>Instalador del plugin MemoriaCalc para Autodesk Revit 2023–2026.</Description>
    <PlatformTarget>x64</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="bundle.zip" Condition="Exists('bundle.zip')" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>
</Project>
